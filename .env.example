# Copy to .env (next to compose.yaml) and fill in. .env holds secrets and
# is never committed. After changing it, apply with:
#   docker compose up -d
# (a plain "docker compose restart" does NOT re-read .env).
# The step-by-step deployment guide is SETUP-GUIDE.md.

# --- Database ----------------------------------------------------------
POSTGRES_DB=ehs_inspection
POSTGRES_USER=ehs_app
POSTGRES_PASSWORD=change-me

# --- Sessions ------------------------------------------------------------
# A long random string, e.g. the output of: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
PASSWORD_SALT_ROUNDS=12

# --- Address and HTTPS -------------------------------------------------
# The https:// address people use to reach the app, with no trailing
# slash. Include the port only if HTTPS_PORT is not 443.
FRONTEND_ORIGIN=https://ehs.example.com

# Other https:// addresses that serve this same deployment, comma-separated,
# for example the Microsoft Entra application proxy URL that phones use:
#   FRONTEND_ADDITIONAL_ORIGINS=https://sonaehsdriveline-sonagroup.msappproxy.net
# Microsoft sign-in returns each browser to the address it started on, so
# each one also needs <address>/api/auth/entra/callback registered as a Web
# redirect URI on the app registration. See ENTRA-APP-PROXY.md.
FRONTEND_ADDITIONAL_ORIGINS=

# nginx serves HTTPS only, on this host port. Nothing listens on port 80.
HTTPS_PORT=443

# Directory on the host holding tls.crt (server certificate followed by
# any intermediate certificates) and tls.key. Relative to compose.yaml.
TLS_CERT_DIR=./certs

# The API is also published on 127.0.0.1 only, for health checks and
# troubleshooting from the server itself.
API_PORT=3000

# --- Self sign-up --------------------------------------------------------
# Leave empty to follow the identity setup: sign-up is open while the app
# runs on passwords only, and closed once Entra ID is configured below.
# "true" or "false" forces it. Break-glass accounts are created with
#   docker compose exec backend node scripts/admin.js create-local-user ...
SELF_SIGNUP_ENABLED=

# --- Microsoft Entra ID single sign-on -------------------------------
# Optional. Leave all three blank and the app runs on username and
# password only; the sign-in button is not drawn. Set all three together.
# See guide.md for where each value comes from in the Microsoft Entra
# admin center.
#
# ENTRA_CLIENT_SECRET is a credential of the same class as JWT_SECRET
# and POSTGRES_PASSWORD: it belongs in .env and never in source control.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Leave blank to use FRONTEND_ORIGIN + /api/auth/entra/callback, which is
# what the app registration's Web redirect URI must then be. Only set it
# if the registered address differs.
ENTRA_REDIRECT_URI=

# Optional. Only needed when the Entra app roles are not already named
# after this app's role codes (USER, EHS_OFFICER, HOD, PLANT_HEAD, ADMIN),
# as "DirectoryValue=APP_ROLE" pairs:
#   ENTRA_ROLE_MAP=EHS.Officer=EHS_OFFICER,EHS.PlantHead=PLANT_HEAD
ENTRA_ROLE_MAP=

# Only for a sovereign cloud: https://login.microsoftonline.us (US
# Government) or https://login.partner.microsoftonline.cn (China).
ENTRA_AUTHORITY=

# Text of the sign-in button. Default "Login with Entra SSO".
ENTRA_BUTTON_LABEL=

# Rarely changed: the OIDC scopes (default "openid profile email") and
# the claim carrying app roles (default "roles").
ENTRA_SCOPES=
ENTRA_ROLE_CLAIM=

# Role given to somebody who signs in through Entra without any app
# role assigned. Set it empty (ENTRA_DEFAULT_ROLE=) to refuse those
# sign-ins instead; remove the line entirely to use USER.
ENTRA_DEFAULT_ROLE=USER

# --- Photograph storage ------------------------------------------------
# "local" keeps photographs on the ehs_uploads Docker volume.
# "sharepoint" stores new ones in a SharePoint document library through
# Microsoft Graph; check the connection with
#   docker compose exec backend node scripts/sharepoint.js check
PHOTO_STORAGE=local

# The site's address, e.g. https://contoso.sharepoint.com/sites/EHSInspection
SHAREPOINT_SITE_URL=
# Optional: the site id used when granting the app access to the site
# (contoso.sharepoint.com,<guid>,<guid>). Skips looking it up by address.
SHAREPOINT_SITE_ID=
# The document library's name as shown in SharePoint. Default "Documents".
SHAREPOINT_LIBRARY=
# Folder inside the library for everything this app stores.
# Default "EHS Inspection".
SHAREPOINT_FOLDER=

# Leave blank to use the Entra app registration above (it then needs the
# Sites.Selected application permission). Set all three to use a
# separate app registration for storage.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# Only for a sovereign cloud: the sign-in host (as ENTRA_AUTHORITY) and
# the Graph host, e.g. https://graph.microsoft.us.
SHAREPOINT_AUTHORITY=
GRAPH_BASE_URL=

# --- Outbound proxy ----------------------------------------------------
# Only if this server reaches Microsoft (login.microsoftonline.com,
# graph.microsoft.com, <tenant>.sharepoint.com) through a proxy.
# NODE_USE_ENV_PROXY=1 is what makes Node's fetch honour HTTPS_PROXY.
HTTPS_PROXY=
NODE_USE_ENV_PROXY=

# --- Email alerts (SMTP) ---------------------------------------------------
# Optional. Leave SMTP_HOST empty and no email is sent. See SETUP-GUIDE.md,
# "Email alerts". Alerts go to the email address on each person's account
# (for Microsoft sign-in users, their company address).
#
#  - HOD: an observation report the auditee has not sent for approval within
#    HOD_ALERT_DAYS (15) days of being generated.
#  - Plant Head: the same, after PLANT_HEAD_ALERT_DAYS (30) days.
#  - Auditors and auditees: every Monday, a reminder of audits and closures
#    still open from earlier weeks.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465). With false, STARTTLS is required unless
# SMTP_REQUIRE_TLS=false.
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
# false only for an internal relay whose certificate is not publicly trusted.
SMTP_TLS_REJECT_UNAUTHORIZED=true
# Both, or neither for a relay that does not ask for a login.
SMTP_USER=
SMTP_PASSWORD=
# Required when SMTP_HOST is set, e.g. EHS Inspection <ehs-alerts@sonacomstar.com>
SMTP_FROM=
ALERTS_ENABLED=true
# Alerts go out after this time of day, in this time zone.
ALERT_SEND_TIME=09:00
ALERT_TIMEZONE=Asia/Kolkata
ALERT_CHECK_INTERVAL_MINUTES=15
HOD_ALERT_DAYS=15
PLANT_HEAD_ALERT_DAYS=30
