POSTGRES_DB=ehs_inspection
POSTGRES_USER=ehs_app
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
PASSWORD_SALT_ROUNDS=12
APP_PORT=8090
API_PORT=3000

# --- Microsoft Entra ID single sign-on -------------------------------
# Optional. Leave all three blank and the app runs on username and
# password only; the "Login with Entra SSO" button is not drawn.
# Set all three together. See guide.md for where each value comes from
# in the Microsoft Entra admin centre.
#
# ENTRA_CLIENT_SECRET is a credential of the same class as JWT_SECRET
# and POSTGRES_PASSWORD: it belongs in .env, which is not committed,
# and never in source control.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Must match a Redirect URI registered on the application character for
# character. Point it at the public address of this app, not localhost,
# once it is deployed.
ENTRA_REDIRECT_URI=http://localhost:8090/api/auth/entra/callback

# Optional. Only needed when the Entra app roles are not already named
# after this app's role codes, as "DirectoryValue=APP_ROLE" pairs:
#   ENTRA_ROLE_MAP=EHS.Officer=EHS_OFFICER,EHS.ActionHod=ACTION_HOD
ENTRA_ROLE_MAP=

# Only for a sovereign cloud: login.microsoftonline.us (US Government)
# or login.partner.microsoftonline.cn (China). Leave blank otherwise.
ENTRA_AUTHORITY=

# Role given to somebody who signs in through Entra without any app
# role assigned. Set it empty to refuse those sign-ins instead.
ENTRA_DEFAULT_ROLE=USER
