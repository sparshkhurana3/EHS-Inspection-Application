NODE_ENV=development
PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ehs_inspection
DATABASE_USER=ehs_app
DATABASE_PASSWORD=replace_with_secure_password
DATABASE_SSL=false

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

PASSWORD_SALT_ROUNDS=12

FRONTEND_ORIGIN=http://localhost:5173

# Everything else - Entra ID sign-in, SELF_SIGNUP_ENABLED, PHOTO_STORAGE
# and the SHAREPOINT_* settings - is read the same way; the root
# .env.example documents each one. Under Docker Compose the root .env is
# the only file read, and this one is ignored.
